VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui
VITE_SUPABASE_FUNCTIONS_URL=https://seu-projeto.supabase.co

# Robo de enriquecimento de Compras pelo ERP (Vercel Cron / Trigger.dev)
# Usa service role porque precisa pegar fila, gravar lock e atualizar compras/fotos.
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
CATALOGO_PEDIDOS_API_KEY=

# Analista de Compras (server-side, configurar na Vercel; nao usar VITE)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
COMPRAS_IA_TIMEOUT_MS=8000

COMPRAS_ERP_PRELOAD_ENABLED=true
COMPRAS_ERP_PRELOAD_MAX_ITEMS=5
COMPRAS_ERP_PRELOAD_DELAY_MS=1500
COMPRAS_ERP_PRELOAD_SCAN_LIMIT=250
COMPRAS_ERP_PRELOAD_LOCK_TTL_MINUTES=5

# Trigger.dev — chave usada pelo FRONTEND para disparar tasks (expedicao-sync do
# app do Rafael e erp-foto-sync). SEM ela, a integracao com a expedicao NAO dispara
# (falha silenciosa: so um console.warn). Configurar tambem no ambiente da Vercel.
VITE_TRIGGER_API_KEY=

# Expedicao Integration (app do Rafael). Estas ficam no ambiente do TRIGGER.DEV
# (nao no front): mesma URL, chaves diferentes por loja.
EXPEDICAO_API_KEY=          # chave Newshop
EXPEDICAO_API_KEY_SF=       # chave Soye e Facil

# Catalogo -> Trigger.dev -> SCAN.
# No ambiente do TRIGGER.DEV, configurar CATALOGO_PEDIDOS_API_KEY igual ao SCAN
# e, se necessario, CATALOGO_PEDIDOS_SCAN_API_URL.
CATALOGO_PEDIDOS_SCAN_API_URL=https://scan-newshop-main.vercel.app/api/catalogo-pedido

# DanfeCollector -> SCAN: consulta CNPJ/IE no cadastro de cliente.
# Usado pela rota server-side /api/danfe-fornecedor; nao exponha esta chave com prefixo VITE.
DANFE_COLLECTOR_API_URL=https://danfe.newgrup.cloud
DANFE_COLLECTOR_API_KEY=

# ERP / Varejo Facil API
# Em producao, erp-proxy / erp-image-proxy rodam na Vercel em /api/*.
# Configure estes valores no ambiente da Vercel. Se usar Supabase Edge Function
# como fallback, configure os mesmos nomes como secrets do Supabase.
# So precisa de um jeito de autenticar por empresa: USERNAME+PASSWORD (login automatico,
# recomendado) OU TOKEN fixo (nao se renova sozinho se expirar).
ERP_API_USERNAME_NEWSHOP=
ERP_API_PASSWORD_NEWSHOP=
ERP_API_TOKEN_NEWSHOP=
ERP_API_URL_NEWSHOP=https://newshop.varejofacil.com

ERP_API_USERNAME_FACIL=
ERP_API_PASSWORD_FACIL=
ERP_API_TOKEN_FACIL=
ERP_API_URL_FACIL=https://facil.varejofacil.com

# SOYE usa o mesmo host do FACIL, mas pode ter credencial propria (a especifica
# sempre vence a do FACIL, se as duas existirem).
ERP_API_USERNAME_SOYE=
ERP_API_PASSWORD_SOYE=
ERP_API_TOKEN_SOYE=

# SEFULY tem base ERP propria (adicionado por #GEMINI)
ERP_API_USERNAME_SEFULY=
ERP_API_PASSWORD_SEFULY=
ERP_API_TOKEN_SEFULY=
ERP_API_URL_SEFULY=https://sefuly.varejofacil.com

# Fallback geral (usado so se nao houver variante por empresa)
ERP_API_USERNAME=
ERP_API_PASSWORD=
ERP_API_TOKEN=

# Sync de fotos do APP para o ERP (Trigger.dev - env separado do Supabase/Vercel)
# Habilitar com "true" para que fotos tiradas no app subam para o cadastro do produto no ERP.
ERP_FOTO_SYNC_ENABLED=false
