# Conector de pre-venda SCAN -> SYSpdv
# Copie para `.env` na MESMA pasta do pdv-connector.mjs e preencha.
# ATENCAO: esse arquivo contem a service_role key. Nao versionar, nao compartilhar.

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# service_role (Settings > API > service_role). A chave anon NAO serve: a baixa
# da fila e restrita ao service_role.
SUPABASE_SERVICE_ROLE_KEY=

# ── Loja ────────────────────────────────────────────────────────────────────
# Loja que este servidor atende. Um conector por retaguarda.
PDV_EMPRESA=SEFULY

# ── Pastas ──────────────────────────────────────────────────────────────────
# Pasta que a retaguarda/SYSpdv le para importar pre-venda (RPX*.ECF).
# CONFIRMAR o caminho exato na instalacao antes de ligar.
PDV_PASTA_DESTINO=C:\SYSPDV\IMPORTA

# Opcional: copia de auditoria de tudo que foi entregue (nunca lida pelo PDV).
PDV_PASTA_ARQUIVO=C:\SYSPDV\SCAN_ENVIADOS

# ── Operacao ────────────────────────────────────────────────────────────────
# Intervalo do polling em ms (15s e um bom padrao).
PDV_INTERVALO_MS=15000
# Quantas pre-vendas processar por ciclo.
PDV_LOTE=5
# Encoding do arquivo. O conteudo ja e ASCII puro; latin1 e o seguro para legado.
PDV_ENCODING=latin1
# Log em arquivo (alem do console). Deixe vazio para so console.
PDV_LOG_FILE=C:\SYSPDV\scan-pdv-connector.log
# Identificacao deste servidor nos logs da fila. Default: hostname da maquina.
# PDV_HOST=RETAGUARDA-SEFULY
